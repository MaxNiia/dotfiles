# Fonts
font-family = "IosevkaTerm Nerd Font Mono"
font-family-bold = "IosevkaTerm Nerd Font Mono"
font-family-italic = "IosevkaTerm Nerd Font Mono"
font-family-bold-italic = "IosevkaTerm Nerd Font Mono"
# font-feature = liga, ss09, cv02, cv05
font-size = 10

# Mouse
mouse-hide-while-typing = true

# Theme
theme = light:catppuccin-latte.conf,dark:catppuccin-mocha.conf
cursor-invert-fg-bg = true
background-opacity = 1.0
window-theme = ghostty
adjust-cursor-thickness = 180%

# KeyBindings
keybind = alt+shift+comma=reload_config
keybind = alt+shift+i=inspector:toggle
keybind = alt+equal=increase_font_size:1
keybind = alt+minus=decrease_font_size:1

keybind = alt+zero=reset_font_size

keybind = alt+shift+c=copy_to_clipboard
keybind = alt+shift+b=write_screen_file:paste
keybind = alt+shift+enter=toggle_fullscreen

confirm-close-surface = false

# Window
gtk-single-instance = true
gtk-tabs-location = bottom
gtk-wide-tabs = false
window-padding-balance = true
window-decoration = false
window-save-state = always
window-inherit-font-size = true
window-inherit-working-directory = true

scrollback-limit = 100000000

# Other
copy-on-select = clipboard
shell-integration = zsh
shell-integration-features = cursor,sudo
app-notifications = no-clipboard-copy
clipboard-write = allow
clipboard-read = allow

# Remove opacity
unfocused-split-opacity = 0.85
unfocused-split-fill = #ccd0da

# term
term = ghostty
